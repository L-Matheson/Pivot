# Copy to .env (npm run up does this automatically). Dev-only values; never commit real secrets.
POSTGRES_USER=pivot
POSTGRES_PASSWORD=pivot
POSTGRES_DB=pivot
# Host ports (change if a local Postgres/Redis already uses them)
POSTGRES_PORT=5432
REDIS_PORT=6379

# Backend settings (PIVOT_ prefix). Inside compose the hosts are the service names.
PIVOT_DEBUG=true
PIVOT_CORS_ORIGINS=["http://localhost:5173"]
PIVOT_DATABASE_URL=postgresql+psycopg://pivot:pivot@postgres:5432/pivot
PIVOT_REDIS_URL=redis://redis:6379/0

# JWT auth.  CHANGE SECRET_KEY in production:  python -c "import secrets; print(secrets.token_hex(32))"
PIVOT_SECRET_KEY=change-me-in-production-use-a-random-secret
# PIVOT_JWT_ALGORITHM=RS256
# RS256 key pair (auto-generated in debug mode; required in production).
# Generate:  python -c "from app.core.config import _generate_rsa_keypair; k,_=_generate_rsa_keypair(); print(k)"
# PIVOT_JWT_PRIVATE_KEY=
# PIVOT_JWT_PUBLIC_KEY=
# PIVOT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# PIVOT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Connection encryption.  CHANGE in production:  python -c "import secrets; print(secrets.token_hex(32))"
PIVOT_ENCRYPTION_KEY=change-me-in-production-use-a-random-key

# Google OAuth (required for Google connector — get from Google Cloud Console)
# PIVOT_GOOGLE_CLIENT_ID=
# PIVOT_GOOGLE_CLIENT_SECRET=
